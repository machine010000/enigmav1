# Environment
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql://...

# NVIDIA NIM API
NVIDIA_API_KEY=nvapi-...
AI_MODEL=meta/llama-3.3-70b-instruct
AI_PROVIDER=nvidia

# JWT
SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis
# For development: redis://localhost:6379/0
# For production (serverless/Vercel): Use Redis Cloud or Upstash
REDIS_URL=redis://localhost:6379/0

# Upwork Marketplace Adapter
UPWORK_CLIENT_ID=your-upwork-client-id
UPWORK_CLIENT_SECRET=your-upwork-client-secret
UPWORK_REDIRECT_URI=http://localhost:8000/callback

# CORS
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
ALLOW_REGISTRATION=false