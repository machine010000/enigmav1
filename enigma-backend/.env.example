# Environment
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql://...

# NVIDIA NIM API
NVIDIA_API_KEY=nvapi-...
AI_MODEL=meta/llama-3.3-70b-instruct
KEYWORD_RESEARCH_MODEL=meta/llama-3.1-8b-instruct
AI_PROVIDER=nvidia

# JWT
SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis
# Development: redis://localhost:6379/0
# Production: Use Redis Cloud or Upstash
REDIS_URL=redis://localhost:6379/0

# Upwork Marketplace Adapter (TASK-051)
UPWORK_CLIENT_ID=your-upwork-client-id
UPWORK_CLIENT_SECRET=your-upwork-client-secret
# Development: http://localhost:8000/callback
# Production: https://yourdomain.com/callback
UPWORK_REDIRECT_URI=http://localhost:8000/callback

# Fiverr Marketplace Adapter (TASK-051)
FIVERR_CLIENT_ID=your-fiverr-client-id
FIVERR_CLIENT_SECRET=your-fiverr-client-secret
# Development: http://localhost:8000/callback
# Production: https://yourdomain.com/callback
FIVERR_REDIRECT_URI=http://localhost:8000/callback

# Freelancer Marketplace Adapter (TASK-051)
FREELANCER_CLIENT_ID=your-freelancer-client-id
FREELANCER_CLIENT_SECRET=your-freelancer-client-secret
FREELANCER_API_TOKEN=
FREELANCER_SANDBOX=false
# Development: http://localhost:8000/callback
# Production: https://yourdomain.com/callback
FREELANCER_REDIRECT_URI=http://localhost:8000/callback

# Mostaql Marketplace Adapter (TASK-051)
MOSTAQL_CLIENT_ID=your-mostaql-client-id
MOSTAQL_CLIENT_SECRET=your-mostaql-client-secret
# Development: http://localhost:8000/callback
# Production: https://yourdomain.com/callback
MOSTAQL_REDIRECT_URI=http://localhost:8000/callback

# Application Base URL for OAuth callbacks (TASK-051)
# Development: http://localhost:8000
# Production: https://yourdomain.com
APP_BASE_URL=http://localhost:8000

# CORS
# Development: http://localhost:3000
# Production: https://yourdomain.com
# Comma-separated exact frontend origins (scheme + host + optional port only).
# Example production value: https://your-project.vercel.app
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
ALLOW_REGISTRATION=false
ADMIN_USER_EMAIL=admin@enigma.local

# Timeouts
API_TIMEOUT_SECONDS=30
DATABASE_TIMEOUT_SECONDS=10
REDIS_TIMEOUT_SECONDS=5

# Retry Policy
MAX_RETRIES=3
RETRY_DELAY_SECONDS=1
